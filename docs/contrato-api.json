{
  "versao": "1.0.0",
  "etapa": "operacional",
  "estadoProduto": "operacional_local",
  "implementacaoAtual": [
    "API HTTP completa (server/**) sobre PostgreSQL (pg com DATABASE_URL ou PGlite embutido)",
    "frontend servido em /",
    "testes de backend em tests/backend"
  ],
  "convencoes": {
    "base": "/api",
    "conteudo": "application/json; charset=utf-8",
    "sucesso": "{data: objeto|lista, meta?: {cursor?: string}}; health é a exceção de bootstrap documentada",
    "erro": {
      "error": {
        "code": "VALIDATION_ERROR",
        "message": "Entrada inválida.",
        "fields": {
          "campo": "motivo"
        }
      }
    },
    "erros": {
      "400": "JSON, query ou parâmetros inválidos",
      "401": "Sessão ausente, inválida ou expirada",
      "403": "Papel sem permissão ou CSRF inválido",
      "404": "Recurso inexistente ou não pertencente ao solicitante",
      "409": "Conflito de horário, versão ou idempotência",
      "413": "Corpo acima de 64 KiB",
      "415": "Content-Type não suportado",
      "422": "Regra de negócio recusada",
      "429": "Limite de requisições, com Retry-After",
      "500": "Erro interno sem stack ou SQL",
      "503": "Banco ou provedor necessário indisponível"
    },
    "datas": "Instantes ISO 8601 com offset, persistidos timestamptz UTC; datas locais YYYY-MM-DD; fuso IANA do estabelecimento. Intervalos [inicio,fim).",
    "dinheiro": "Inteiro em centavos BRL; valor e duração congelados no agendamento.",
    "ids": "UUID gerado no servidor; validar UUID antes de consultar.",
    "paginacao": "limit inteiro 1..100 (padrão 25); cursor opaco validado; períodos da agenda limitados a 31 dias.",
    "validacao": "Rejeitar campos desconhecidos; verificar tipo, comprimento e formato na fronteira; SQL parametrizado; textos como texto, nunca HTML.",
    "concorrencia": "Transação e exclusion constraint PostgreSQL por profissional/recurso; conflito 23P01 vira 409 SLOT_CONFLICT; reagendar não perde reserva original se falhar.",
    "idempotencia": "POST /appointments exige Idempotency-Key aleatória de 16..128 caracteres; chave vinculada à identidade e hash do corpo por 24h; mesmo corpo retorna resultado anterior, corpo diferente 409.",
    "versao": "PATCH de entidades mutáveis exige campo version inteiro positivo; atualização condicional; versão obsoleta retorna 409 VERSION_CONFLICT."
  },
  "seguranca": {
    "sessao": "Cookie opaco aleatório com pelo menos 256 bits; somente hash persistido. Em produção __Host-bp_session, HttpOnly, Secure, SameSite=Lax, Path=/, sem Domain. Expiração absoluta 7 dias e inatividade 12h; logout e troca de credencial revogam sessão.",
    "csrf": "GET /auth/csrf entrega token vinculado à sessão anônima/autenticada. Toda mutação exige X-CSRF-Token e validação de Origin allowlist, inclusive cadastro/login. Sem CORS aberto com credenciais.",
    "cliente": "Cadastro pede somente nome e telefone com DDD. Gera sessão de dispositivo para novo cadastro. Telefone existente nunca concede acesso: fluxo de recuperação/prova de posse por provedor. Resposta de cadastro é genérica, indistinguível para impedir enumeração; aparelho recebe o mesmo cookie anônimo/promovido opaco.",
    "recuperacao": "Desafio de posse enviado por provedor SMS/WhatsApp configurado; token armazenado por hash, TTL 5min, uso único, até 5 tentativas; respostas genéricas e limitação por IP e telefone. Sem provedor retorna 503, sem modo simulado nem código fixo. Contas administrativas não recuperadas pelo cadastro público.",
    "equipe": "Login e senha com scrypt/Argon2id e salt aleatório; nenhum segredo inicial versionado. Onboarding admin por comando interativo controlado pela frente backend/devops; não criar senha de teste ou rota de bootstrap pública.",
    "autorizacao": "customer somente próprios dados; barber somente agenda própria e campos estritamente necessários; admin configura e gerencia. ID alheio retorna 404. Telefone e UUID isolados nunca autorizam.",
    "privacidade": "Dados de exemplo sem pessoas reais. Agenda pública exibe apenas horários disponíveis; não devolve nomes ou telefones. Logs sem telefone, cookies, tokens ou senhas; trilha administrativa de metadados sem segredos.",
    "rateLimit": "Limites compartilhados em armazenamento persistente: cadastro 5/15min/IP, login e desafios 5/15min/IP e identidade normalizada; limites de leitura e reserva configuráveis. Sem depender de memória de um único processo em produção."
  },
